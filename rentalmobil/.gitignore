# LuxRental - Git Ignore File

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store

# Configuration files (contain sensitive data)
config/koneksi.php

# Upload directories (user-generated content)
uploads/*
!uploads/.gitkeep
uploads/mobil/*
!uploads/mobil/.gitkeep

# Backup files
backup/
*.bak
*.backup
*.sql.backup

# Logs
*.log
logs/
error_log
access_log

# Temporary files
tmp/
temp/
*.tmp

# Composer dependencies
vendor/
composer.lock

# Node modules (if using npm)
node_modules/
package-lock.json

# Build files
dist/
build/

# Cache directories
cache/
*.cache

# Session files
sessions/
*.sess

# Database dumps (except schema)
*.sql
!rental1.sql

# Environment files
.env
.env.local
.env.*.local

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# PHP specific
*.phar
.phpunit.result.cache

# MacOS
.AppleDouble
.LSOverride
._*

# Windows
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Archives
*.zip
*.tar
*.gz
*.rar
*.7z

# Test files
tests/coverage/
phpunit.xml
